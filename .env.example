# PostgreSQL 16 local development values. Do not use these defaults in production.
POSTGRES_DB=political_archive
POSTGRES_USER=political_archive
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432

# Application settings use the PA_ prefix. These are useful when running the CLI
# in a container; outside Compose, database_host defaults to 127.0.0.1.
PA_DATABASE_HOST=127.0.0.1
PA_DATABASE_PORT=5432
PA_DATABASE_NAME=political_archive
PA_DATABASE_USER=political_archive
PA_DATABASE_PASSWORD=dev-only-change-me
